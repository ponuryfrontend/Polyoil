{% layout none %}
<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zestaw 2+1 · Grecka Oliwa Extra Virgin z Kalamaty | Polyoil</title>
<meta name="description" content="Kup 2 butelki świeżej greckiej oliwy extra virgin, trzecią dostajesz gratis. Zbiór 2025/2026, jedna farma na Peloponezie, 353,92 mg/kg polifenoli, badanie laboratoryjne.">
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@400;500;600;700;800&family=Fredoka:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="icon" href="https://polyoil.pl/cdn/shop/files/Zrzut_ekranu_2026-04-29_o_10.08.32.png?v=1777450121&width=64">
<style>
:root{
  --blue:#3485c5;
  --blue-deep:#175280;
  --blue-dark:#123f63;
  --blue-bg:#e7f0f8;
  --ink:#1c2a36;
  --white:#ffffff;
  --cream:#efeee6;
  --cream-2:#e5e4d9;
  --line:#dcdacc;
  --gold:#c29a3c;
  --gold-bg:#f6efdc;
  --green:#5f8a3c;
  --green-bg:#ecf2e2;
  --red:#b0512f;
  --muted:#5f6b76;
  --radius:12px;
  --maxw:1160px;
  --font-h:'DM Serif Display', Georgia, serif;
  --font-b:'DM Sans', sans-serif;
  --font-sub:'Fredoka', sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:var(--font-b);color:var(--ink);background:var(--white);line-height:1.55;-webkit-font-smoothing:antialiased;}
img{max-width:100%;display:block;}
a{color:inherit;text-decoration:none;}
.container{max-width:var(--maxw);margin:0 auto;padding:0 24px;}
h1,h2,h3{font-family:var(--font-h);font-weight:400;line-height:1.12;letter-spacing:0;}
h4{font-family:var(--font-b);font-weight:700;}
.eyebrow{font-family:var(--font-sub);font-size:13px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--blue);}
.section{padding:76px 0;}
.section--tight{padding:56px 0;}
.section--cream{background:var(--cream);}
.section--blue{background:var(--blue-deep);color:#fff;}
.section-head{max-width:680px;margin:0 auto 44px;text-align:center;}
.section-head h2{font-size:clamp(28px,3.6vw,40px);margin-top:10px;}
.section-head p{color:var(--muted);margin-top:14px;font-size:16px;}
.section--blue .section-head p{color:#c6d8e8;}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--font-b);font-weight:700;font-size:16px;padding:16px 28px;border-radius:10px;border:none;cursor:pointer;transition:transform .15s ease, box-shadow .15s ease;}
.btn-primary{background:var(--blue);color:#fff;box-shadow:0 6px 18px rgba(52,133,197,.32);}
.btn-primary:hover{transform:translateY(-1px);box-shadow:0 10px 22px rgba(52,133,197,.4);}
.btn-block{width:100%;}
.btn-lg{padding:18px 32px;font-size:17px;}
.btn-ghost{background:#fff;color:var(--blue-deep);border:1.5px solid var(--blue);box-shadow:none;}
.btn-ghost:hover{background:var(--blue-bg);transform:translateY(-1px);}

/* Top bar */
.topbar{background:linear-gradient(100deg, var(--blue-dark) 0%, var(--blue-deep) 55%, var(--blue) 100%);color:#fff;}
.topbar .container{display:flex;align-items:center;justify-content:center;gap:22px;padding-top:11px;padding-bottom:11px;flex-wrap:wrap;text-align:center;}
.topbar-msg{font-size:13.5px;font-weight:700;letter-spacing:.01em;}
.topbar-msg .sub{font-weight:500;opacity:.92;margin-left:4px;}
.topbar-clock{display:flex;align-items:center;gap:6px;}
.topbar-clock .tc-unit{background:rgba(255,255,255,.16);border-radius:6px;padding:4px 8px;min-width:38px;text-align:center;}
.topbar-clock .tc-num{font-family:var(--font-sub);font-weight:600;font-size:15px;line-height:1;font-variant-numeric:tabular-nums;display:block;}
.topbar-clock .tc-lbl{font-size:8.5px;letter-spacing:.06em;opacity:.8;display:block;margin-top:2px;}
.topbar-clock .tc-sep{opacity:.6;font-weight:700;}
@media (max-width:640px){.topbar-msg{font-size:12px;} .topbar .container{gap:10px;}}

/* Header */
header{border-bottom:1px solid var(--line);position:sticky;top:0;background:#fff;z-index:50;}
header .container{display:flex;align-items:center;justify-content:space-between;padding-top:14px;padding-bottom:14px;}
header img.logo{height:34px;}
.nav-links{display:flex;gap:28px;font-size:14px;font-weight:600;}
.nav-links a{color:var(--ink);opacity:.7;}
.nav-links a:hover{opacity:1;}
@media (max-width:760px){.nav-links{display:none;}}

/* Hero */
.hero{padding:52px 0 64px;background:linear-gradient(180deg,#f4f7fa 0%,#fff 100%);}
.hero .container{display:grid;grid-template-columns:1.05fr 0.95fr;gap:56px;align-items:center;}
@media (max-width:900px){.hero .container{grid-template-columns:1fr;gap:36px;}}
.offer-badge{display:inline-flex;align-items:center;gap:8px;background:var(--blue-bg);color:var(--blue-deep);font-family:var(--font-sub);font-weight:600;font-size:13.5px;padding:8px 14px;border-radius:999px;margin-bottom:16px;}
.hero h1{font-size:clamp(33px,4.5vw,52px);margin-bottom:10px;}
.hero h1 .h1-problem{display:block;color:var(--muted);font-size:.6em;font-family:var(--font-b);font-weight:700;letter-spacing:.01em;margin-bottom:10px;line-height:1.3;}
.hero h1 em{font-style:italic;color:var(--blue);}
.hero .sub{font-size:17px;color:var(--muted);margin-bottom:24px;max-width:540px;}
.stat-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:22px;}
.stat-card{background:var(--cream);border-radius:var(--radius);padding:14px 12px;text-align:center;}
.stat-card .num{font-family:var(--font-sub);font-weight:600;font-size:20px;color:var(--blue-deep);}
.stat-card .lbl{font-size:11.5px;color:var(--muted);margin-top:2px;line-height:1.25;}
.rating-row{display:flex;align-items:center;gap:8px;font-size:14px;margin-bottom:22px;flex-wrap:wrap;}
.stars{color:var(--gold);letter-spacing:1px;}
.rating-row .rlabel{color:var(--muted);}
.price-block{border:1px solid var(--line);border-radius:14px;padding:22px;margin-bottom:22px;background:#fff;}
.price-block .pb-top{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;}
.pb-qty{font-weight:700;font-size:14.5px;}
.pb-save{background:var(--green-bg);color:var(--green);font-weight:700;font-size:12.5px;padding:4px 10px;border-radius:999px;}
.pb-price{display:flex;align-items:baseline;gap:12px;margin-top:10px;}
.pb-price .old{text-decoration:line-through;color:var(--muted);font-size:19px;}
.pb-price .now{font-family:var(--font-sub);font-size:38px;font-weight:600;color:var(--blue-deep);}
.pb-note{font-size:13.5px;color:var(--muted);margin-top:6px;}
.trust-row{display:flex;flex-wrap:wrap;gap:14px;margin-top:20px;font-size:12.5px;color:var(--muted);font-weight:600;}
.trust-row span{display:flex;align-items:center;gap:6px;}
.trust-row span:before{content:"✓";color:var(--green);font-weight:800;}

.hero-visual{position:relative;}
.hero-visual .imgwrap{border-radius:22px;overflow:hidden;box-shadow:0 24px 48px rgba(18,63,99,.22);}
.hero-visual img{width:100%;}
.free-stamp{position:absolute;top:18px;right:8px;background:var(--blue);color:#fff;font-family:var(--font-sub);font-weight:600;font-size:13px;padding:10px 14px;border-radius:999px;transform:rotate(6deg);box-shadow:0 8px 18px rgba(18,63,99,.35);text-align:center;z-index:2;}
.float-card{position:absolute;left:8px;bottom:-16px;background:#fff;border:1px solid var(--line);border-radius:12px;padding:12px 16px;box-shadow:0 12px 28px rgba(18,63,99,.15);font-size:13px;font-weight:600;z-index:2;}
@media (max-width:900px){.float-card{position:static;margin-top:14px;display:inline-block;}}

/* Problem section */
.problem-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:8px;}
@media (max-width:900px){.problem-grid{grid-template-columns:repeat(2,1fr);}}
@media (max-width:560px){.problem-grid{grid-template-columns:1fr;}}
.problem-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:20px;font-size:14.5px;font-weight:600;}
.problem-card .x{color:var(--red);font-size:20px;font-weight:800;margin-bottom:8px;display:block;}
.problem-card small{display:block;font-weight:500;color:var(--muted);margin-top:6px;font-size:12.5px;}

/* Proof blocks */
.proof-block{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center;margin-bottom:64px;}
.proof-block:last-child{margin-bottom:0;}
@media (max-width:880px){.proof-block{grid-template-columns:1fr;gap:28px;}}
.panel-brand{display:flex;align-items:center;gap:12px;margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid var(--line);}
.panel-brand img{height:44px;width:44px;object-fit:cover;border-radius:8px;border:1px solid var(--line);}
.panel-brand b{font-size:14px;display:block;color:var(--blue-deep);}
.panel-brand span{font-size:11.5px;color:var(--muted);display:block;}
.pc-row.us{background:var(--blue-bg);border:1.5px solid var(--blue);border-radius:12px;padding:12px 14px;}
.pc-row.us .pc-label span:first-child{color:var(--blue-deep);font-weight:800;}
.tile-badge{display:inline-block;font-family:var(--font-sub);font-size:10.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:3px 10px;border-radius:999px;margin-bottom:10px;}
.tile-badge.them{background:#eceade;color:#8a8672;}
.tile-badge.us{background:var(--blue);color:#fff;}
.acid-tile.good{border:1.5px solid var(--blue);background:var(--blue-bg);}
.media-caption{background:var(--blue-deep);color:#fff;font-size:12.5px;font-weight:600;padding:10px 16px;text-align:center;}
.proof-tag{display:inline-flex;align-items:center;gap:8px;background:var(--blue-deep);color:#fff;font-family:var(--font-sub);font-weight:600;font-size:13px;letter-spacing:.1em;text-transform:uppercase;padding:8px 16px;border-radius:999px;margin-bottom:16px;}
.proof-copy h3{font-size:clamp(23px,2.8vw,32px);margin-bottom:14px;}
.proof-copy p{color:var(--muted);font-size:15.5px;margin-bottom:12px;}
.proof-copy p b{color:var(--ink);}
.proof-media{border-radius:18px;overflow:hidden;box-shadow:0 18px 40px rgba(18,63,99,.16);}
.proof-media img{width:100%;}
.proof-panel{background:#fff;border:1px solid var(--line);border-radius:18px;padding:28px;box-shadow:0 18px 40px rgba(18,63,99,.08);}
.pc-row{margin-bottom:20px;}
.pc-row:last-child{margin-bottom:0;}
.pc-label{display:flex;justify-content:space-between;font-size:13.5px;font-weight:600;margin-bottom:7px;gap:12px;}
.pc-label .val{font-weight:800;white-space:nowrap;}
.pc-bar{height:16px;border-radius:999px;background:var(--cream-2);overflow:hidden;}
.pc-fill{height:100%;border-radius:999px;}
.pc-fill.market{width:12%;background:#c2bfae;}
.pc-fill.mid{width:52%;background:var(--gold);}
.pc-fill.poly{width:74%;background:var(--blue);}
.pc-note{font-size:12px;color:var(--muted);margin-top:16px;line-height:1.6;}
.claim{background:var(--green-bg);border-left:3px solid var(--green);border-radius:0 10px 10px 0;padding:14px 16px;font-size:13.5px;color:var(--ink);margin-top:6px;}
.acid-panel{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.acid-tile{background:#fff;border:1px solid var(--line);border-radius:14px;padding:22px;text-align:center;}
.acid-tile .big{font-family:var(--font-sub);font-weight:600;font-size:30px;color:var(--blue-deep);}
.acid-tile.bad .big{color:#a3a08f;}
.acid-tile .lbl{font-size:12.5px;color:var(--muted);margin-top:4px;line-height:1.4;}

/* Polyphenols 101 */
.poly-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
@media (max-width:900px){.poly-grid{grid-template-columns:repeat(2,1fr);}}
@media (max-width:560px){.poly-grid{grid-template-columns:1fr;}}
.poly-card{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.16);border-radius:14px;padding:24px;}
.poly-card .pc-ico{font-size:24px;margin-bottom:12px;display:block;}
.poly-card h4{font-size:16px;margin-bottom:8px;color:#fff;}
.poly-card p{font-size:13.5px;color:#c6d8e8;line-height:1.6;}

/* Benefit cards */
.benefit-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
@media (max-width:900px){.benefit-grid{grid-template-columns:repeat(2,1fr);}}
@media (max-width:560px){.benefit-grid{grid-template-columns:1fr;}}
.benefit-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:22px;}
.benefit-card .bc-ico{font-size:22px;margin-bottom:10px;display:block;}
.benefit-card h4{font-size:16px;margin-bottom:6px;}
.benefit-card p{font-size:13.5px;color:var(--muted);}

/* Story */
.story-card{display:grid;grid-template-columns:0.9fr 1.1fr;gap:0;border:1px solid var(--line);border-radius:18px;overflow:hidden;background:#fff;max-width:980px;margin:0 auto;}
@media (max-width:820px){.story-card{grid-template-columns:1fr;}}
.story-card img{width:100%;height:100%;object-fit:cover;min-height:280px;}
.story-body{padding:36px;}
.story-body h3{font-size:24px;margin:8px 0 14px;}
.story-body p{font-size:14.5px;color:var(--muted);margin-bottom:12px;}
.story-body p b{color:var(--ink);}

/* Comparison */
.cmp-table{width:100%;border-collapse:collapse;font-size:14px;}
.cmp-table th,.cmp-table td{padding:14px 16px;border-bottom:1px solid var(--line);text-align:center;}
.cmp-table th{font-size:13px;font-weight:800;}
.cmp-table td:first-child,.cmp-table th:first-child{text-align:left;font-weight:600;}
.cmp-table th:nth-child(2){background:var(--blue-bg);border-radius:10px 10px 0 0;color:var(--blue-deep);}
.cmp-table td:nth-child(2){background:var(--blue-bg);font-weight:700;}
.cmp-table .yes{color:var(--green);font-weight:800;}
.cmp-table .no{color:var(--red);font-weight:800;}
.cmp-scroll{overflow-x:auto;}

/* Reviews */
.review-summary{display:flex;align-items:center;gap:18px;justify-content:center;margin-bottom:40px;flex-wrap:wrap;}
.review-summary .big{font-family:var(--font-sub);font-size:44px;font-weight:600;color:var(--blue-deep);}
.review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
@media (max-width:900px){.review-grid{grid-template-columns:repeat(2,1fr);}}
@media (max-width:600px){.review-grid{grid-template-columns:1fr;}}
.review-card{border:1px solid var(--line);border-radius:var(--radius);padding:20px;background:#fff;}
.review-card .rc-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;}
.review-card .rc-name{font-weight:700;font-size:14.5px;}
.review-card .rc-verified{font-size:11px;color:var(--green);font-weight:700;}
.review-card p{font-size:14px;color:var(--ink);}
.review-card .rc-src{font-size:11.5px;color:var(--muted);margin-top:8px;}

/* Offer / value stack */
.offer-wrap{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--line);border-radius:16px;overflow:hidden;}
@media (max-width:900px){.offer-wrap{grid-template-columns:1fr;}}
.ship-status-row{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:18px;}
.ss-pill{display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--line);border-radius:999px;padding:9px 16px;font-size:13px;font-weight:600;}
.ss-dot{width:8px;height:8px;border-radius:50%;background:var(--green);display:inline-block;flex-shrink:0;}
.demand-divider{display:flex;align-items:center;gap:14px;margin-bottom:22px;}
.demand-divider:before,.demand-divider:after{content:"";flex:1;height:1px;background:var(--line);}
.demand-divider span{font-family:var(--font-sub);font-weight:600;font-size:12px;letter-spacing:.06em;color:var(--red);white-space:nowrap;}
.offer-left{background:var(--blue-deep);color:#fff;padding:40px;}
.offer-left .eyebrow{color:#9cc4e4;}
.offer-left h2{color:#fff;font-size:30px;margin:10px 0 20px;}
.stack-item{display:flex;justify-content:space-between;align-items:center;padding:13px 0;border-bottom:1px solid rgba(255,255,255,.14);font-size:14.5px;}
.stack-item.free .amt{color:#a5e6b8;font-weight:700;}
.stack-item .strike{text-decoration:line-through;opacity:.55;margin-right:6px;}
.stack-total{display:flex;justify-content:space-between;padding-top:16px;font-size:14px;opacity:.85;}
.stack-total.final{font-size:24px;font-weight:400;font-family:var(--font-h);opacity:1;padding-top:10px;}
.stack-save{background:rgba(255,255,255,.1);border-radius:8px;padding:10px 14px;margin-top:14px;font-size:13px;font-weight:600;}
.offer-right{padding:40px;background:#fff;}
.field-label{font-weight:700;font-size:13.5px;margin-bottom:10px;display:block;}
.bundle-box{border:1.5px solid var(--blue);border-radius:10px;padding:16px;margin-bottom:22px;}
.bb-name{font-weight:700;font-size:14.5px;display:block;}
.bb-detail{font-size:13px;color:var(--muted);margin-top:6px;}
.bb-price-row{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:12px;flex-wrap:wrap;}
.bb-price-row .po-price{white-space:nowrap;font-size:19px;font-weight:700;}
.po-old{text-decoration:line-through;color:var(--muted);font-weight:500;font-size:13px;margin-right:6px;}
.bb-save-pill{background:var(--green-bg);color:var(--green);font-weight:700;font-size:12.5px;padding:5px 12px;border-radius:999px;white-space:nowrap;}
.cta-main{display:block;white-space:nowrap;}
.cta-sub{display:block;font-size:12px;font-weight:500;opacity:.75;margin-top:3px;letter-spacing:.02em;}
#mainCta{flex-direction:column;gap:0;padding:15px 28px;}
.guarantee-line{display:flex;align-items:center;gap:8px;justify-content:center;font-size:12.5px;font-weight:700;color:var(--ink);margin-top:14px;text-align:center;}
.ship-line{display:flex;align-items:center;gap:10px;font-size:12.5px;color:var(--muted);margin-top:12px;justify-content:center;text-align:center;}
.trust-bar{display:flex;align-items:center;gap:16px;margin-top:22px;padding:18px 20px;background:#fff;border:1px solid var(--line);border-radius:14px;flex-wrap:wrap;}
.trust-avatars{display:flex;flex-shrink:0;}
.ta-avatar{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:14px;border:2px solid #fff;margin-left:-10px;box-shadow:0 0 0 1px var(--line);}
.ta-avatar:first-child{margin-left:0;}
.ta-avatar.ta-check{background:var(--gold);font-size:15px;}
.trust-text b{font-size:14px;display:block;margin-bottom:2px;}
.trust-text p{font-size:12.5px;color:var(--muted);}

/* Gallery */
.gallery-grid{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:16px;}
@media (max-width:760px){.gallery-grid{grid-template-columns:1fr 1fr;}.gallery-item--tall{grid-column:span 2;}}
.gallery-item{background:#fff;border-radius:14px;overflow:hidden;border:1px solid var(--line);}
.gallery-item img{width:100%;height:100%;object-fit:cover;}

/* FAQ */
.faq-item{border-bottom:1px solid var(--line);}
.faq-q{display:flex;justify-content:space-between;align-items:center;padding:20px 4px;cursor:pointer;font-weight:600;font-size:15.5px;}
.faq-q .plus{font-size:20px;font-weight:400;transition:transform .2s;flex-shrink:0;margin-left:16px;}
.faq-item.open .faq-q .plus{transform:rotate(45deg);}
.faq-a{max-height:0;overflow:hidden;transition:max-height .25s ease;font-size:14.5px;color:var(--muted);}
.faq-item.open .faq-a{max-height:260px;}
.faq-a p{padding:0 4px 20px;}

/* Final CTA */
.final-cta{text-align:center;}
.final-cta h2{color:#fff;font-size:clamp(28px,4.2vw,42px);margin-bottom:14px;}
.final-cta p{color:#c6d8e8;margin-bottom:26px;font-size:16px;}

/* Footer */
footer{background:var(--cream);padding:40px 0 100px;}
footer .container{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:24px;}
footer img.logo{height:28px;margin-bottom:12px;}
footer .fdisc{max-width:640px;font-size:11.5px;color:var(--muted);line-height:1.6;}
footer .fdisc a{text-decoration:underline;}
footer .fcopy{font-size:12.5px;color:var(--muted);}

/* Sticky mobile bar */
