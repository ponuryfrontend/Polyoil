<script>
// FAQ accordion
document.querySelectorAll('.faq-q').forEach(function(q){
  q.addEventListener('click', function(){
    var item = q.parentElement;
    var wasOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(function(i){ i.classList.remove('open'); });
    if(!wasOpen){ item.classList.add('open'); }
  });
});

// Sticky bar on scroll
var stickyBar = document.getElementById('stickyBar');
window.addEventListener('scroll', function(){
  var heroBottom = document.querySelector('.hero').getBoundingClientRect().bottom;
  if(heroBottom < 0){ stickyBar.classList.add('show'); } else { stickyBar.classList.remove('show'); }
});

// Evergreen 7-day offer countdown, persisted per visitor
function updateOfferCountdown(){
  var KEY = 'polyoil2plus1Deadline';
  var now = Date.now();
  var deadline = parseInt(localStorage.getItem(KEY), 10);
  if(!deadline || isNaN(deadline) || deadline <= now){
    deadline = now + 7*24*60*60*1000;
    localStorage.setItem(KEY, String(deadline));
  }
  var diff = deadline - now;
  var d = Math.floor(diff/86400000);
  var h = Math.floor((diff%86400000)/3600000);
  var m = Math.floor((diff%3600000)/60000);
  var s = Math.floor((diff%60000)/1000);
  var pad = function(n){ return String(n).padStart(2,'0'); };
  document.getElementById('tcDays').textContent = pad(d);
  document.getElementById('tcHours').textContent = pad(h);
  document.getElementById('tcMins').textContent = pad(m);
  document.getElementById('tcSecs').textContent = pad(s);
}
updateOfferCountdown();
setInterval(updateOfferCountdown, 1000);
</script>

