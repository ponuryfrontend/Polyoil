    "custom_liquid_UQXJBC": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div style=\"max-width: 900px; margin: 40px auto; padding: 0 20px; font-family: inherit; color: #175280;\">\n  <h2 style=\"margin-bottom: 10px; color: #175280;\">Wyniki niezależnego badania laboratoryjnego</h2>\n\n  <p style=\"color: #175280; margin-bottom: 20px;\">\n    W lutym 2025 r. <strong>Politechnika Łódzka</strong> (Instytut Technologii i Analizy Żywności) przebadała Polyoil. Pełne wyniki publikujemy jawnie &mdash; bez selektywnego cytowania.\n  </p>\n\n  <table style=\"width: 100%; border-collapse: collapse; background: #ffffff; box-shadow: 0 1px 4px rgba(0,0,0,0.08); border-radius: 8px; overflow: hidden;\">\n    <thead>\n      <tr style=\"background-color: #3485c5; color: #ffffff;\">\n        <th style=\"padding: 10px 14px; text-align: left; font-weight: 600; color: #ffffff;\">Parametr</th>\n        <th style=\"padding: 10px 14px; text-align: left; font-weight: 600; color: #ffffff;\">Polyoil</th>\n        <th style=\"padding: 10px 14px; text-align: left; font-weight: 600; color: #ffffff;\">Norma / referencja</th>\n      </tr>\n    </thead>\n\n    <tbody>\n      <tr style=\"background-color: #f7f9fc;\">\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280;\">Polifenole ogółem</td>\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280; font-weight: bold;\">353,92 mg/kg</td>\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280;\">EU 432/2012: &ge; 250 mg/kg dla claimu zdrowotnego</td>\n      </tr>\n\n      <tr style=\"background-color: #ffffff;\">\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280;\">Kwas oleinowy (omega-9)</td>\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280; font-weight: bold;\">76,39 g/100 g</td>\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280;\">IOC dla extra virgin: 55&ndash;83 g/100 g</td>\n      </tr>\n\n      <tr style=\"background-color: #f7f9fc;\">\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280;\">Kwasowość</td>\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280; font-weight: bold;\">0,3 %</td>\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280;\">Norma extra virgin EU: &le; 0,8 %</td>\n      </tr>\n\n      <tr style=\"background-color: #ffffff;\">\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280;\">Kwasy nienasycone (suma)</td>\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280; font-weight: bold;\">84,50 g/100 g</td>\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280;\">im wyższe, tym lepiej</td>\n      </tr>\n\n      <tr style=\"background-color: #f7f9fc;\">\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280;\">Kwasy jednonienasącone</td>\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280; font-weight: bold;\">77,19 g/100 g</td>\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280;\">profil charakterystyczny dla oliwy</td>\n      </tr>\n\n      <tr style=\"background-color: #ffffff;\">\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280;\">Kwasy wielonienasącone</td>\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280; font-weight: bold;\">7,31 g/100 g</td>\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280;\">&mdash;</td>\n      </tr>\n\n      <tr style=\"background-color: #f7f9fc;\">\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280;\">Kwasy nasycone (suma)</td>\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280; font-weight: bold;\">15,50 g/100 g</td>\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280;\">im niższe, tym lepiej</td>\n      </tr>\n\n      <tr style=\"background-color: #ffffff;\">\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280;\">Omega-3 (ALA)</td>\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280; font-weight: bold;\">0,77 g/100 g</td>\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280;\">&mdash;</td>\n      </tr>\n\n      <tr style=\"background-color: #f7f9fc;\">\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280;\">Omega-6 (LA)</td>\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280; font-weight: bold;\">6,53 g/100 g</td>\n        <td style=\"padding: 9px 14px; border-bottom: 1px solid #e8edf2; color: #175280;\">&mdash;</td>\n      </tr>\n\n      <tr style=\"background-color: #ffffff;\">\n        <td style=\"padding: 9px 14px; color: #175280;\">Omega-9</td>\n        <td style=\"padding: 9px 14px; color: #175280; font-weight: bold;\">76,71 g/100 g</td>\n        <td style=\"padding: 9px 14px; color: #175280;\">dominujący kwas w oliwie extra virgin</td>\n      </tr>\n    </tbody>\n  </table>\n\n  <p style=\"color: #175280; margin-top: 14px;\">\n    Sprawozdanie sporządziła dr hab. inż. Joanna Oracz, zatwierdziła prof. dr hab. inż. Grażyna Budryn (Dyrektor Instytutu). Data: 7.02.2025.\n  </p>\n\n  <p style=\"margin-top: 8px;\">\n    <strong>\n      <a href=\"https://cdn.shopify.com/s/files/1/0961/4835/7453/files/sprawozdanie_instytutu_technologi_i_analizy_zywnosci_do_oliwy_z_oliwek_polyoil.jpg?v=1778744098\" style=\"color: #175280; text-decoration: none;\" title=\"Sprawozdanie\">\n        Zobacz pełne sprawozdanie z Politechniki Łódzkiej (PDF) &rarr;\n      </a>\n    </strong>\n  </p>\n</div>",
