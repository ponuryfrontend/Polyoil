{{ 'polyoil-why.css' | asset_url | stylesheet_tag }}

{% style %}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.body_font | font_face: font_display: 'swap' }}
{% endstyle %}

<section
  class="polyoil-why"
  style="
    --polyoil-why-bg: {{ section.settings.bg_color }};
    --polyoil-why-heading: {{ section.settings.heading_color }};
    --polyoil-why-accent: {{ section.settings.accent_color }};
    --polyoil-why-text: {{ section.settings.text_color }};

    --polyoil-why-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --polyoil-why-heading-weight: {{ section.settings.heading_font.weight }};
    --polyoil-why-heading-style: {{ section.settings.heading_font.style }};
    --polyoil-why-heading-size: {{ section.settings.heading_size }}px;
    --polyoil-why-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;

    --polyoil-why-body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    --polyoil-why-body-weight: {{ section.settings.body_font.weight }};
    --polyoil-why-body-style: {{ section.settings.body_font.style }};

    --polyoil-why-tile-title-size: {{ section.settings.tile_title_size }}px;
    --polyoil-why-tile-title-size-mobile: {{ section.settings.tile_title_size_mobile }}px;

    --polyoil-why-tile-desc-size: {{ section.settings.tile_desc_size }}px;
    --polyoil-why-tile-desc-size-mobile: {{ section.settings.tile_desc_size_mobile }}px;

    --polyoil-why-body-size: {{ section.settings.body_size }}px;
    --polyoil-why-body-size-mobile: {{ section.settings.body_size_mobile }}px;

    --polyoil-why-tile-icon-size: {{ section.settings.tile_icon_size }}px;
    --polyoil-why-tile-icon-size-mobile: {{ section.settings.tile_icon_size_mobile }}px;

    --polyoil-why-right-icon-size: {{ section.settings.right_icon_size }}px;
    --polyoil-why-right-icon-size-mobile: {{ section.settings.right_icon_size_mobile }}px;

    --polyoil-why-max-width: {{ section.settings.max_width }}px;

    --polyoil-why-padding-top: {{ section.settings.padding_top }}px;
    --polyoil-why-padding-bottom: {{ section.settings.padding_bottom }}px;
    --polyoil-why-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --polyoil-why-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;

    --polyoil-why-margin-top: {{ section.settings.margin_top }}px;
    --polyoil-why-margin-bottom: {{ section.settings.margin_bottom }}px;
    --polyoil-why-margin-top-mobile: {{ section.settings.margin_top_mobile }}px;
    --polyoil-why-margin-bottom-mobile: {{ section.settings.margin_bottom_mobile }}px;
  "
>
  <div class="polyoil-why__inner">
    <div class="polyoil-why__grid">

      {%- comment -%} ===== LEWA STRONA: nagłówek + 4 kafelki ===== {%- endcomment -%}
      <div class="polyoil-why__left">
        {%- if section.settings.left_heading != blank -%}
          <h2 class="polyoil-why__heading">{{ section.settings.left_heading }}</h2>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="polyoil-why__tiles" data-count="{{ section.blocks.size }}">
            {%- for block in section.blocks -%}
              <div class="polyoil-why__tile" {{ block.shopify_attributes }}>
                {%- if block.settings.title != blank -%}
                  <div class="polyoil-why__tile-title">{{ block.settings.title }}</div>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <div class="polyoil-why__tile-desc">{{ block.settings.description }}</div>
                {%- endif -%}
                {%- if block.settings.icon != blank -%}
                  <div class="polyoil-why__tile-icon-wrap">
                    <img
                      src="{{ block.settings.icon | image_url: width: 200 }}"
                      alt="{{ block.settings.icon.alt | escape }}"
                      class="polyoil-why__tile-icon"
                      loading="lazy"
                      width="64"
                      height="64"
                    >
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ===== PRAWA STRONA: nagłówek + ikona/tekst + tekst pod spodem ===== {%- endcomment -%}
      <div class="polyoil-why__right">
        {%- if section.settings.right_heading != blank -%}
          <h2 class="polyoil-why__heading">{{ section.settings.right_heading }}</h2>
        {%- endif -%}

        {%- if section.settings.right_icon != blank or section.settings.right_description != blank -%}
          <div class="polyoil-why__icon-text">
            {%- if section.settings.right_icon != blank -%}
              <div class="polyoil-why__icon-wrap">
                <img
                  src="{{ section.settings.right_icon | image_url: width: 300 }}"
                  alt="{{ section.settings.right_icon.alt | escape }}"
                  class="polyoil-why__icon"
                  loading="lazy"
                  width="120"
                  height="120"
                >
              </div>
            {%- endif -%}
            {%- if section.settings.right_description != blank -%}
              <div class="polyoil-why__description">{{ section.settings.right_description }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.right_footer != blank -%}
          <div class="polyoil-why__footer">{{ section.settings.right_footer }}</div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
