{{ 'polyoil-stats.css' | asset_url | stylesheet_tag }}

{% style %}
  {{ section.settings.eyebrow_font | font_face: font_display: 'swap' }}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.value_font | font_face: font_display: 'swap' }}
  {{ section.settings.label_font | font_face: font_display: 'swap' }}
{% endstyle %}

<section
  class="polyoil-stats"
  style="
    --polyoil-stats-bg: {{ section.settings.bg_color }};
    --polyoil-stats-card-bg: {{ section.settings.card_bg }};
    --polyoil-stats-accent: {{ section.settings.accent_color }};
    --polyoil-stats-eyebrow: {{ section.settings.eyebrow_color }};
    --polyoil-stats-label: {{ section.settings.label_color }};
    --polyoil-stats-heading: {{ section.settings.heading_color }};
    --polyoil-stats-border: {{ section.settings.border_color }};

    --polyoil-stats-eyebrow-font: {{ section.settings.eyebrow_font.family }}, {{ section.settings.eyebrow_font.fallback_families }};
    --polyoil-stats-eyebrow-weight: {{ section.settings.eyebrow_font.weight }};
    --polyoil-stats-eyebrow-style: {{ section.settings.eyebrow_font.style }};
    --polyoil-stats-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --polyoil-stats-eyebrow-size-mobile: {{ section.settings.eyebrow_size_mobile }}px;

    --polyoil-stats-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --polyoil-stats-heading-weight: {{ section.settings.heading_font.weight }};
    --polyoil-stats-heading-style: {{ section.settings.heading_font.style }};
    --polyoil-stats-heading-size: {{ section.settings.heading_size }}px;
    --polyoil-stats-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --polyoil-stats-heading-max-width: {{ section.settings.heading_max_width }}px;
    --polyoil-stats-heading-max-width-mobile: {{ section.settings.heading_max_width_mobile }}px;

    --polyoil-stats-value-font: {{ section.settings.value_font.family }}, {{ section.settings.value_font.fallback_families }};
    --polyoil-stats-value-weight: {{ section.settings.value_font.weight }};
    --polyoil-stats-value-style: {{ section.settings.value_font.style }};
    --polyoil-stats-value-size: {{ section.settings.value_size }}px;
    --polyoil-stats-value-size-mobile: {{ section.settings.value_size_mobile }}px;

    --polyoil-stats-label-font: {{ section.settings.label_font.family }}, {{ section.settings.label_font.fallback_families }};
    --polyoil-stats-label-weight: {{ section.settings.label_font.weight }};
    --polyoil-stats-label-style: {{ section.settings.label_font.style }};
    --polyoil-stats-label-size: {{ section.settings.label_size }}px;
    --polyoil-stats-label-size-mobile: {{ section.settings.label_size_mobile }}px;

    --polyoil-stats-padding-top: {{ section.settings.padding_top }}px;
    --polyoil-stats-padding-bottom: {{ section.settings.padding_bottom }}px;
    --polyoil-stats-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --polyoil-stats-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;

    --polyoil-stats-margin-top: {{ section.settings.margin_top }}px;
    --polyoil-stats-margin-bottom: {{ section.settings.margin_bottom }}px;
    --polyoil-stats-margin-top-mobile: {{ section.settings.margin_top_mobile }}px;
    --polyoil-stats-margin-bottom-mobile: {{ section.settings.margin_bottom_mobile }}px;

    --polyoil-stats-gap: {{ section.settings.card_gap }}px;
    --polyoil-stats-gap-mobile: {{ section.settings.card_gap_mobile }}px;
  "
>
  <div class="polyoil-stats__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="polyoil-stats__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="polyoil-stats__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="polyoil-stats__grid"
        data-count="{{ section.blocks.size }}"
      >
        {%- for block in section.blocks -%}
          <div class="polyoil-stats__card" {{ block.shopify_attributes }}>
            {%- if block.settings.value != blank -%}
              <div class="polyoil-stats__value">{{ block.settings.value }}</div>
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              <div class="polyoil-stats__label">{{ block.settings.label }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
