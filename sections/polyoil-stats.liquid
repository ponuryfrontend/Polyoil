      "default": "#3B6D11"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Kolor tekstu nadrzędnego",
      "default": "#639922"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Kolor nagłówka",
      "default": "#2C2C2A"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Kolor etykiet",
      "default": "#5F5E5A"
    },
    {
